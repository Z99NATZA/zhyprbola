#!/usr/bin/env python3
import json
import os
import sys
import time
from pathlib import Path

path = Path(os.environ["SOUND_TEST_STATE"])
state = json.loads(path.read_text())
command, target, *args = sys.argv[1:]
key = "microphone" if target == "@DEFAULT_AUDIO_SOURCE@" else "speaker"
mode = os.environ.get("SOUND_TEST_MODE", "")
if mode == "timeout":
    time.sleep(10)
if mode == "missing_microphone" and key == "microphone":
    sys.exit(1)
if mode == "write_failure" and command != "get-volume":
    sys.exit(1)
if mode == "malformed":
    print("Unexpected response")
    sys.exit(0)
if command == "get-volume":
    print(f'Volume: {state[key]["volume"] / 100:.2f}'
          + (" [MUTED]" if state[key]["muted"] else ""))
else:
    if command == "set-volume":
        state[key]["volume"] = int(args[0].rstrip("%"))
    elif command == "set-mute":
        state[key]["muted"] = args[0] == "1"
    else:
        sys.exit(2)
    path.write_text(json.dumps(state))
