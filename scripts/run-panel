#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PANEL_NAME="${1:-bluetooth}"

case "$PANEL_NAME" in
  bluetooth|wifi)
    ;;
  *)
    echo "Unsupported panel: $PANEL_NAME" >&2
    exit 2
    ;;
esac

if [[ ! -x "$ROOT_DIR/build/zpola" ]]; then
  make -C "$ROOT_DIR" build
fi

"$ROOT_DIR/build/zpola" --panel "$PANEL_NAME"
