#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PANEL_NAME="${1:-bluetooth}"

case "$PANEL_NAME" in
  bluetooth|wifi|clock-weather|system-status|audio-spectrum|music|todo|calendar|settings)
    ;;
  *)
    echo "Unsupported panel: $PANEL_NAME" >&2
    exit 2
    ;;
esac

if [[ ! -x "$ROOT_DIR/build/zhyprbola" ]]; then
  make -C "$ROOT_DIR" build
fi

"$ROOT_DIR/build/zhyprbola" --panel "$PANEL_NAME"
