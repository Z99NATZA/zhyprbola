#!/usr/bin/env python3
"""Export the editable SVG icon to the PNG embedded in the Qt application."""

from pathlib import Path

import cairo
import gi

gi.require_version("Rsvg", "2.0")
from gi.repository import Rsvg


assets = Path(__file__).resolve().parent.parent / "assets"
renderer = Rsvg.Handle.new_from_file(str(assets / "zhyprbola-icon.svg"))
surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 512, 512)
context = cairo.Context(surface)
viewport = Rsvg.Rectangle()
viewport.x = viewport.y = 0
viewport.width = viewport.height = 512
renderer.render_document(context, viewport)
surface.write_to_png(str(assets / "zhyprbola-icon.png"))
print("Exported assets/zhyprbola-icon.png (512 × 512, transparent background)")
