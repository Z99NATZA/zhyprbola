#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}"
APP_ID="org.zhyprbola.Zhyprbola"
DESKTOP_FILE="${DATA_DIR}/applications/${APP_ID}.desktop"
PANEL_COMMAND="${ROOT_DIR}/scripts/run-panel"

install -Dm644 "$ROOT_DIR/assets/zhyprbola-icon.png" \
    "$DATA_DIR/icons/hicolor/512x512/apps/$APP_ID.png"
install -Dm644 "$ROOT_DIR/assets/zhyprbola-icon.svg" \
    "$DATA_DIR/icons/hicolor/scalable/apps/$APP_ID.svg"
mkdir -p "$(dirname -- "$DESKTOP_FILE")"

# Exec has its own quoting rules, including a second layer of backslash
# escaping and percent field codes, even inside double quotes.
DESKTOP_COMMAND="${PANEL_COMMAND//\\/\\\\\\\\}"
DESKTOP_COMMAND="${DESKTOP_COMMAND//\"/\\\\\"}"
DESKTOP_COMMAND="${DESKTOP_COMMAND//\$/\\\\\$}"
DESKTOP_COMMAND="${DESKTOP_COMMAND//\`/\\\\\`}"
DESKTOP_COMMAND="${DESKTOP_COMMAND//%/%%}"
cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=Zhyprbola
Comment=Configure the Zhyprbola dock and desktop panels
Exec=env "$DESKTOP_COMMAND" settings
Icon=$APP_ID
Terminal=false
Categories=Settings;
StartupWMClass=$APP_ID
EOF

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$DATA_DIR/applications"
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache --force --ignore-theme-index "$DATA_DIR/icons/hicolor" >/dev/null
fi

echo "Installed $APP_ID launcher and icon"
