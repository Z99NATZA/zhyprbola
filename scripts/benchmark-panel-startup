#!/usr/bin/env python3
"""Measure launch-to-first-frame offscreen, without changing desktop settings."""
import argparse
import json
import os
from pathlib import Path
import selectors
import statistics
import subprocess
import tempfile
import time


def first_frame(binary, panel, qml, environment):
    started = time.perf_counter()
    with subprocess.Popen([str(binary), "--panel", panel, str(qml)], env=environment,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT) as process:
        output = b""
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while b"ZHYPRBOLA_FIRST_FRAME" not in output:
                    remaining = 15 - (time.perf_counter() - started)
                    if remaining <= 0 or not selector.select(remaining):
                        raise RuntimeError(f"{panel}: no frame within 15 seconds")
                    chunk = os.read(process.stdout.fileno(), 65536)
                    if not chunk:
                        raise RuntimeError(output.decode(errors="replace"))
                    output += chunk
            elapsed = (time.perf_counter() - started) * 1000
            process.communicate(timeout=15)
            if process.returncode:
                raise RuntimeError(f"{panel}: exited with {process.returncode}")
            return round(elapsed, 1)
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("panels", nargs="*", default=["calendar", "settings", "wifi", "music"])
    parser.add_argument("--runs", type=int, default=3)
    options = parser.parse_args()
    if options.runs < 1:
        parser.error("--runs must be positive")
    root = Path(__file__).resolve().parent.parent
    binary = root / "build/zhyprbola"
    if not binary.is_file():
        parser.error("Build the application with make build first")
    results = {}
    with tempfile.TemporaryDirectory(prefix="zhyprbola-startup-") as temporary:
        directory = Path(temporary)
        qml = directory / "Startup.qml"
        qml.write_text('import QtQuick\nimport "' + root.as_uri() + '"\n'
                       'PanelHost { onFrameSwapped: { console.log("ZHYPRBOLA_FIRST_FRAME"); Qt.quit() } }\n')
        environment = dict(os.environ, QT_QPA_PLATFORM="offscreen", QT_QUICK_BACKEND="software",
                           XDG_CONFIG_HOME=str(directory / "config"), XDG_CACHE_HOME=str(directory / "cache"))
        for panel in options.panels:
            first_frame(binary, panel, qml, environment)  # Warm the QML/disk caches.
            samples = [first_frame(binary, panel, qml, environment) for _ in range(options.runs)]
            results[panel] = {"median_ms": statistics.median(samples), "samples_ms": samples}
    print(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
