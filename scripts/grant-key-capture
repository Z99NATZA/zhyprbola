#!/usr/bin/env bash
set -euo pipefail

if ! command -v setfacl >/dev/null; then
    printf 'setfacl is required (install the acl package).\n' >&2
    exit 1
fi

devices=()
for device in /dev/input/event*; do
    [[ -e "$device" ]] || continue
    if udevadm info --query=property --name="$device" | grep -qx 'ID_INPUT_KEYBOARD=1'; then
        devices+=("$device")
    fi
done

if ((${#devices[@]} == 0)); then
    printf 'No keyboard input devices found.\n' >&2
    exit 1
fi

if ((EUID == 0)); then
    [[ -n "${PKEXEC_UID:-}" ]] || { printf 'Missing requesting user.\n' >&2; exit 1; }
    requester="$PKEXEC_UID"
    setfacl -m "u:${requester}:r" "${devices[@]}"
else
    requester="$(id -u)"
    sudo setfacl -m "u:${requester}:r" "${devices[@]}"
fi
printf 'Temporary read access granted to %s keyboard device(s).\n' "${#devices[@]}"
