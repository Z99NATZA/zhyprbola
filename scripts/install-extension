#!/usr/bin/env bash
set -euo pipefail

# All bundle inputs and the install destination are local files. Avoid GVfs
# metadata requests, which can stall packaging when its session service hangs.
export GIO_USE_VFS=local

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
UUID="zhyprbola@znnn.local"
PACK_DIR="${ROOT_DIR}/build/extension-pack"

# Keep the installed extension usable until the new bundle is ready.
rm -rf "$PACK_DIR"
mkdir -p "$PACK_DIR"

printf '#!/usr/bin/env bash\nexec %q/scripts/run-panel "$@"\n' "$ROOT_DIR" > "$PACK_DIR/panel-command.sh"
chmod +x "$PACK_DIR/panel-command.sh"
printf '#!/usr/bin/env bash\nexec %q/build/key-capture-evdev --count-only\n' "$ROOT_DIR" > "$PACK_DIR/key-count-command.sh"
chmod +x "$PACK_DIR/key-count-command.sh"

echo "Packing $UUID..."
gnome-extensions pack "$ROOT_DIR/gnome-extension" \
  --schema="$ROOT_DIR/gnome-extension/schemas/org.gnome.shell.extensions.zhyprbola.gschema.xml" \
  --extra-source="$PACK_DIR/panel-command.sh" \
  --extra-source="$PACK_DIR/key-count-command.sh" \
  --extra-source="$ROOT_DIR/scripts/key-count-capture.js" \
  --extra-source="$ROOT_DIR/scripts/grant-key-capture" \
  --extra-source="$ROOT_DIR/gnome-extension/soundMenu.js" \
  --extra-source="$ROOT_DIR/gnome-extension/brightnessMenu.js" \
  --extra-source="$ROOT_DIR/gnome-extension/batteryMenu.js" \
  --extra-source="$ROOT_DIR/gnome-extension/ddcBrightness.js" \
  --extra-source="$ROOT_DIR/gnome-extension/screenshotEdge.js" \
  --extra-source="$ROOT_DIR/gnome-extension/wallpapers" \
  --extra-source="$ROOT_DIR/gnome-extension/icons" \
  --force \
  --out-dir "$PACK_DIR" >/dev/null
echo "Installing $UUID..."
gnome-extensions install --force "$PACK_DIR/${UUID}.shell-extension.zip"

echo "Installed $UUID from $ROOT_DIR/gnome-extension"
